# Configuracion del FRONTEND (solo se usa al compilar con `npm run build`).
#
# Si la API y la pagina estan en el mismo dominio (instalacion con
# deploy/setup.sh), NO hace falta este archivo: la pagina usa /api.
#
# Solo si el frontend va en Cloudflare Pages y la API en la Pi, copiar a .env
# (o poner la variable en Pages → Settings → Environment variables):
VITE_API_URL=https://api.tudominio.org/api
