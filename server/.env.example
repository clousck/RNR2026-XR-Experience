# Configuracion del servidor de RNR Quest.
# Copiar a server/.env (deploy/setup.sh lo hace solo y completa APP_SECRET).
# No hay API keys de servicios externos: el proyecto no usa ninguno.

# ============================================================
#  DOMINIO  (lo unico que hay que cambiar al comprar el dominio)
# ============================================================
# Donde abren los participantes, sin https://. Con esto se arman los QR y se
# permite el acceso (CORS). Ej.: quest.ieee-ecuador.org
APP_DOMAIN=quest.tudominio.org

# ============================================================
#  SECRETO  (generarlo una vez y no compartirlo)
# ============================================================
# Firma las URLs de las fotos privadas. Si cambia, los enlaces viejos dejan de
# funcionar (nada se pierde). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ============================================================
#  SERVIDOR
# ============================================================
NODE_ENV=production
PORT=8787
# 127.0.0.1: solo el tunel de Cloudflare habla con la API (recomendado).
HOST=127.0.0.1

# Base de datos (quest.db) y fotos (files/). En una Raspberry Pi, mejor en un SSD.
DATA_DIR=/var/lib/rnr-quest

# Carpeta del frontend compilado: la API sirve tambien la pagina (todo en un
# dominio). Dejar vacio si el frontend va en Cloudflare Pages.
STATIC_DIR=

# ============================================================
#  OPCIONAL
# ============================================================
# Solo si el frontend esta en OTRO dominio que APP_DOMAIN (separados por coma).
# Por defecto se usa https://APP_DOMAIN.
# CORS_ORIGINS=https://quest.tudominio.org,https://rnr-quest.pages.dev

# Tamaño maximo de una foto (MB). El telefono ya la reduce a ~0.5 MB.
MAX_PHOTO_MB=10

# ============================================================
#  SOLO CON DOCKER  (docs/docker.md)
# ============================================================
# Con docker compose, NODE_ENV, HOST, PORT, DATA_DIR y STATIC_DIR los fija
# docker-compose.yml (lo que diga arriba para esas cinco se ignora).
# Token del tunel de Cloudflare (contenedor cloudflared, --profile tunnel).
# TUNNEL_TOKEN=
