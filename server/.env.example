# Copiar a .env y completar. En la Pi, NODE_ENV=production.
NODE_ENV=production
PORT=8787
HOST=127.0.0.1

# Carpeta con la base (quest.db) y las fotos (files/). En la Pi, idealmente en un SSD.
DATA_DIR=/srv/rnr-quest/data

# Secreto para firmar las URLs de las fotos. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Dominios del frontend que pueden usar la API (separados por coma).
# Vacio = cualquiera (la API usa tokens, no cookies).
CORS_ORIGINS=https://quest.tudominio.org

# Opcional: servir tambien el frontend compilado desde la Pi (un solo dominio).
# STATIC_DIR=/srv/rnr-quest/app/dist

# Tamaño maximo de una foto (MB). El telefono ya la reduce a ~0.5 MB.
MAX_PHOTO_MB=10
